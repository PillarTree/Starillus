# Pillarium 2.0 desktop (Pillarius Desktop foundation)
pillarium            # the Pillarium 2.0 window manager / shell
spacer-greeter       # LightDM greeter
cadet                # companion toolkit / applications
planet               # package manager front-end
planet-control-center# desktop settings
libreoffice          # LibreOffice office suite (Writer, Calc, Impress, Draw, Base, Math)

# LightDM display manager
lightdm

# Starillus additions
pilot                # Pilot browser (fork of Chromium)
flatpak              # Flatpak support
flatpak-xdg-utils    # Flatpak desktop integration
flatpak-session-helper
xdg-desktop-portal
xdg-desktop-portal-gtk

# Starillus App Center + anti-virus
starillus-app-center # central app platform (Ubuntu App Center-like) with AV
starillus-av         # anti-virus daemon (on-access + scheduled scans)
clamav               # anti-virus engine backing starillus-av
clamav-freshclam     # virus definition updates

# Pillarius base apps
xdg-user-dirs
xdg-utils
p7zip-full
unzip

# Terminal
xterm
